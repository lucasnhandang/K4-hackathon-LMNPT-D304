# Copy file này thành .env và điền giá trị thật
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=student_assistant
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gemini (dùng cho /chat endpoint — hỏi đáp tự do)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# MongoDB Atlas Vector Search
VECTOR_SEARCH_INDEX=kb_vector_index
VECTOR_ANSWER_THRESHOLD=0.83
VECTOR_CLARIFY_THRESHOLD=0.80
VECTOR_TOP_K=5
VECTOR_NUM_CANDIDATES=100

# Guardrails MVP
MAX_MESSAGE_CHARACTERS=2000
USER_REQUESTS_PER_MINUTE=5
CHANNEL_REQUESTS_PER_MINUTE=30
RAW_RETENTION_DAYS=30
REDACTED_RETENTION_DAYS=180
USER_MEMORY_RETENTION_DAYS=180

# Legacy /ask settings
MIN_KB_SIMILARITY=0.35
MIN_CONFIDENCE_TO_ANSWER=0.6

# Discord bot MVP — sinh viên hỏi bằng cách mention @bot
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_KB_CHANNEL_IDS=977644669326475311
KNOWLEDGE_INGEST_USER_PER_MINUTE=10
KNOWLEDGE_INGEST_CHANNEL_PER_MINUTE=60
BACKEND_BASE_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT_SECONDS=90
