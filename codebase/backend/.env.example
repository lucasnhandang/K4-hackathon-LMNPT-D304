# Discord credentials
DISCORD_TOKEN=replace_with_your_bot_token
DISCORD_CLIENT_ID=replace_with_application_id
DISCORD_GUILD_ID=replace_with_server_id

# Kênh bot trả lời
STUDENT_SUPPORT_CHANNEL_ID=replace_with_qa_channel_id
ASSIGNMENT_SUPPORT_CHANNEL_ID=replace_with_qa_channel_id
TECHNICAL_SUPPORT_CHANNEL_ID=replace_with_qa_channel_id

# Kênh được phép thu thập
OFFICIAL_SOURCE_CHANNEL_IDS=replace_with_announcement_id,replace_with_resource_id,replace_with_lesson_id
COMMUNITY_CHANNEL_IDS=replace_with_general_id,replace_with_qa_id,replace_with_sharing_id
COMMAND_CHANNEL_IDS=replace_with_go_commands_id

# Phải gồm đúng 7 ID phía trên; tuyệt đối không thêm kênh activity
COLLECT_CHANNEL_IDS=replace_with_announcement_id,replace_with_resource_id,replace_with_lesson_id,replace_with_general_id,replace_with_qa_id,replace_with_sharing_id,replace_with_go_commands_id

# Kênh nhận ticket
TICKET_OTHER_CHANNEL_ID=replace_with_other_ticket_channel_id
TICKET_BUILD_PHASE_CHANNEL_ID=replace_with_build_phase_ticket_channel_id
TICKET_NEW_TOPIC_CHANNEL_ID=replace_with_new_topic_ticket_channel_id
TICKET_TEAM_CHANNEL_ID=replace_with_team_ticket_channel_id

# OpenRouter LLM
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Dùng đầy đủ provider/model slug và chọn model hỗ trợ tools/tool_choice
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_NAME=AI20K-Student-Assistant
OPENROUTER_SITE_URL=http://localhost
DEFAULT_COHORT=k4
# Alias tạm thời: K4 dùng chung knowledge vận hành/deadline với fixture K3
KNOWLEDGE_COHORT_ALIASES=k4:k3
KNOWLEDGE_COHORT_ALIAS_CATEGORIES=deadline,gate,event

# Collector runtime
DATABASE_PATH=runtime/discord_messages.sqlite3
BACKFILL_ON_START=true
# 0 = toàn bộ lịch sử có quyền đọc; số dương = giới hạn mỗi channel/thread
BACKFILL_LIMIT_PER_CHANNEL=0
DATA_RETENTION_DAYS=30

# Chuỗi bí mật ngẫu nhiên dùng để ẩn danh user ID
PSEUDONYM_SECRET=replace_with_a_long_random_secret
